    "NativeSessionRef": {
      "description": "A provider conversation as the provider names it, within one profile on\nthe local endpoint. The namespace UUID is resolved at admission.",
      "properties": {
        "nativeSessionId": {
          "description": "Opaque, even when it looks like a UUID.",
          "type": "string"
        },
        "profileRef": {
          "description": "The provider profile/store authority (for example a config home).",
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "profileRef",
        "nativeSessionId"
      ],
      "type": "object"
    },
    "NativeSurfaceRef": {
      "description": "A native surface (terminal tab, pane, window). The locator (a TTY path)\nis not identity: the application generation and the adapter's surface\ngeneration are part of the key, so a reused path is a new surface.",
      "properties": {
        "appGeneration": {
          "type": "string"
