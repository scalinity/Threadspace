  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "What admission journals for one accepted observation or owner command:\nthe header the reducer may use, and its resolved facts in order. `cursor`\nis the observation's ingest position (a local commit cursor, SPEC §5.4).",
  "properties": {
    "capturedWallMs": {
      "format": "int64",
      "type": "integer"
