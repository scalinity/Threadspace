<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened-runtime prompting policy for the responsible application of
	     the companion's Apple events (docs/decisions/D-0003). The outer app
	     itself sends no Apple events. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
